    "js-cookie": "^3.0.5",
    "lucide-react": "^0.482.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
